# Copie para terraform.tfvars e preencha os valores reais antes de `terraform apply`.
# Nao commite terraform.tfvars (ja esta no .gitignore da raiz).

api_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-homologation-api:REPLACE_ME_COM_SHA"

workers = {
  audio = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-homologation-worker:audio-REPLACE_ME"
    cpu           = 512
    memory        = 1024
    desired_count = 1
  }
  video-image = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-homologation-worker:video-image-REPLACE_ME"
    cpu           = 1024
    memory        = 2048
    desired_count = 1
  }
  report = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-homologation-worker:report-REPLACE_ME"
    cpu           = 256
    memory        = 512
    desired_count = 1
  }
  orchestrator = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-homologation-worker:orchestrator-REPLACE_ME"
    cpu           = 256
    memory        = 512
    desired_count = 1
  }
}

cognito_callback_urls = ["https://homolog.sentinelhealth.example.com/auth/callback"]
cognito_logout_urls   = ["https://homolog.sentinelhealth.example.com/logout"]
