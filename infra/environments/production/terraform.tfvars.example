# Copie para terraform.tfvars e preencha os valores reais antes de `terraform apply`.
# Nao commite terraform.tfvars (ja esta no .gitignore da raiz).
#
# Producao lida com dados de saude (LGPD/Anvisa) - revisar cada valor com
# atencao antes do primeiro apply, especialmente deletion_protection,
# db_multi_az e cognito_mfa_configuration (definidos com defaults seguros
# em variables.tf, mas listados aqui para visibilidade).

api_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-production-api:REPLACE_ME_COM_SHA"

workers = {
  audio = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-production-worker:audio-REPLACE_ME"
    cpu           = 1024
    memory        = 2048
    desired_count = 2
  }
  video-image = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-production-worker:video-image-REPLACE_ME"
    cpu           = 2048
    memory        = 4096
    desired_count = 2
  }
  report = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-production-worker:report-REPLACE_ME"
    cpu           = 512
    memory        = 1024
    desired_count = 2
  }
  orchestrator = {
    image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sentinelhealth-production-worker:orchestrator-REPLACE_ME"
    cpu           = 512
    memory        = 1024
    desired_count = 2
  }
}

cognito_callback_urls = ["https://app.sentinelhealth.example.com/auth/callback"]
cognito_logout_urls   = ["https://app.sentinelhealth.example.com/logout"]
