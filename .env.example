# Copie para .env (`make setup` faz isso automaticamente) e ajuste se
# necessario. Nenhum valor aqui e um segredo real - todos os adaptadores
# externos (OpenAI, AWS, Azure) comecam desligados (providers LOCAL), e o
# projeto roda 100% localmente sem nenhuma credencial de nuvem.
# NAO commite o arquivo `.env` (ja esta no .gitignore da raiz).

# --- Banco de dados (Postgres do docker compose) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelhealth
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelhealth

# --- Aplicacao ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Armazenamento de midia (LOCAL = filesystem em backend/.local-media) ---
MEDIA_STORAGE_BACKEND=LOCAL

# --- LLM de consolidacao (LOCAL = template deterministico, sem chamada externa) ---
LLM_PROVIDER=LOCAL
# OPENAI_API_KEY=            # so necessario se LLM_PROVIDER=OPENAI

# --- Transcricao de audio (LOCAL = sem motor de ASR, retorna UNAVAILABLE) ---
TRANSCRIPTION_PROVIDER=LOCAL

# --- Visao computacional de video (LOCAL = sem motor de pose/deteccao) ---
VISION_PROVIDER=LOCAL

# --- Identidade (LOCAL = cabecalho X-Dev-Subject, sem MFA - apenas dev) ---
IDENTITY_PROVIDER=LOCAL

# --- AWS (regiao apenas; sem access keys fixas - usa credenciais do ambiente) ---
AWS_REGION=us-east-1

# --- Azure Cognitive Services (opcional, apenas se usar os providers AZURE_*) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_VISION_KEY=
# AZURE_VISION_ENDPOINT=
# AZURE_LANGUAGE_KEY=
# AZURE_LANGUAGE_ENDPOINT=
