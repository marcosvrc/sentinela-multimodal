# ═══════════════════════════════════════════════════════════════════
# SentinelHealth — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════
#
# Copie para .env (`make setup` faz isso automaticamente) e preencha
# os valores necessários. Nenhuma integração externa é obrigatória
# para rodar localmente — todos começam desligados (LOCAL).
#
# NÃO commite o arquivo .env com valores reais (já está no .gitignore).
# ═══════════════════════════════════════════════════════════════════

# --- Banco de dados (Postgres do Docker Compose) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelhealth
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelhealth

# --- Aplicação ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM (consolidação de risco + extração de termos + GPT-4 Vision) ---
# LOCAL = template determinístico, sem chamada externa
# OPENAI = usa OpenAI GPT (requer OPENAI_API_KEY)
LLM_PROVIDER=LOCAL
OPENAI_API_KEY=

# --- Transcrição de áudio ---
# LOCAL = sem motor de ASR, retorna "indisponível"
# AZURE_SPEECH = usa Azure AI Speech (requer AZURE_SPEECH_KEY + AZURE_SPEECH_REGION)
TRANSCRIPTION_PROVIDER=LOCAL

# --- Visão computacional de vídeo (OpenPose/YOLOv8) ---
# LOCAL = sem motor de pose/detecção
# OPENPOSE_YOLOV8 = usa YOLOv8 e/ou OpenPose (requer `make setup-yolo` + feature flags)
VISION_PROVIDER=LOCAL

# --- Azure AI Speech (transcrição de áudio) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Azure AI Vision (reconhecimento de imagem, rótulos genéricos) ---
# Requer feature flag: image_recognition_enabled
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# --- Azure AI Language (análise de sentimento/termos-chave) ---
# Requer feature flag: sentiment_analysis_enabled
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=

# --- Azure Health Data Services (DICOM — imagens médicas) ---
# Requer feature flag: dicom_service_enabled
AZURE_DICOM_ENDPOINT=
AZURE_DICOM_TENANT_ID=
AZURE_DICOM_CLIENT_ID=
AZURE_DICOM_CLIENT_SECRET=
