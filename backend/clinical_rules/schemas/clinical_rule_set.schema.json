{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinicalRuleSet",
  "description": "Schema de um conjunto de regras clinicas versionado (ver ESCOPO_PROJETO.md 12.1.6).",
  "type": "object",
  "required": ["code", "version", "population", "status", "source", "rules"],
  "properties": {
    "code": { "type": "string", "description": "Identificador estavel do sinal/avaliacao, ex: blood_pressure" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "population": { "type": "string", "description": "Ex: adult" },
    "status": { "type": "string", "enum": ["draft", "published", "retired"] },
    "effective_from": { "type": "string", "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "source": {
      "type": "object",
      "required": ["reference", "approved_by"],
      "properties": {
        "reference": { "type": "string" },
        "approved_by": { "type": "string" }
      }
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "required_inputs": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "when", "risk_level", "classification_label"],
        "properties": {
          "id": { "type": "string" },
          "when": { "type": "string", "description": "Expressao de condicao legivel, avaliada pelo motor determinístico" },
          "risk_level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "classification_label": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
